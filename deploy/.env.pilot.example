# Copy to repo root as .env.pilot (do not commit).
# Cheap pilot VPS: 1 vCPU / 1–2 GB RAM is enough for ~2 people.
#
# COMPLIANCE: foreign VPS + LiveKit Cloud = demo only, not аттестация / real ПМД.
# Use synthetic patients only. After first seed set ALLOW_BOOTSTRAP=false.

DOMAIN=miru.example.com

POSTGRES_USER=miru
POSTGRES_PASSWORD=change_me_long_password
POSTGRES_DB=miru
MIRU_APP_PASSWORD=change_me_app_role_password
MIRU_ADMIN_PASSWORD=change_me_admin_role_password

REDIS_PASSWORD=change_me_redis_password

S3_ACCESS_KEY=miru_minio
S3_SECRET_KEY=change_me_minio_secret_16plus

IIN_PEPPER=change_me_iin_pepper_32chars_min____
SESSION_SECRET=change_me_session_secret_32chars_min

# One-shot seed only. Keep false after POST /api/bootstrap/demo
ALLOW_BOOTSTRAP=false
BOOTSTRAP_SECRET=change_me_bootstrap_secret_32chars

# LiveKit Cloud stub — OUTSIDE RK, not for attestation (swap to self-host in RK later)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_PUBLIC_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxx

TELEGRAM_BOT_TOKEN=
