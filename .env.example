# Copy to apps/api/.env as well. Never commit real secrets.

NODE_ENV=development
PORT=3000
TZ=Asia/Almaty
# Local: true. Production: false after seed; if briefly true, set BOOTSTRAP_SECRET ≥24 and send header x-bootstrap-secret
ALLOW_BOOTSTRAP=true
BOOTSTRAP_SECRET=
IIN_PEPPER=miru_dev_iin_pepper_change_me

DATABASE_URL=postgresql://miru:miru_dev_only_change_me@localhost:5432/miru?schema=public
ADMIN_DATABASE_URL=postgresql://miru_admin:miru_admin_dev_only@localhost:5432/miru?schema=public

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=miru_minio
S3_SECRET_KEY=miru_dev_only_change_me
S3_BUCKET_ARTIFACTS=miru-artifacts
S3_BUCKET_RECORDINGS=miru-recordings

LIVEKIT_URL=ws://127.0.0.1:7880
# Public URL for browsers / Telegram (MUST be wss:// for home→clinic).
# For LiveKit Cloud set BOTH URL and PUBLIC to the same wss://….livekit.cloud
LIVEKIT_PUBLIC_URL=
# false = reject loopback/LAN client URLs (correct for patient at home).
# true  = only same-machine demos with local Docker LiveKit.
ALLOW_LOCAL_LIVEKIT=false
LIVEKIT_API_KEY=mirudevkey
LIVEKIT_API_SECRET=miru_livekit_dev_secret_change_me_32chars
LIVEKIT_EGRESS_ENABLED=false
REQUIRE_LIVEKIT_EGRESS=false

NCA_CMS_VERIFY_ENABLED=false

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5177
PDF_FONT_PATH=

TELEGRAM_BOT_TOKEN=
# HTTPS Mini App URL (cloudflared / prod). Used by POST /api/bootstrap/telegram-menu
TELEGRAM_WEBAPP_URL=
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=

SESSION_SECRET=replace_with_long_random_string_dev_only
